{
  "meta": {
    "source": "apps/landing/app/flowstate.css :root (2026-10-26). DTCG flat keys match the CSS variable names exactly. Regenerate both outputs after any edit: npm run build in this folder, commit tokens.css and ../mobile/lib/design/tokens.g.dart if changed."
  },
  "hero-base": {
    "$type": "color",
    "$value": "#04050c"
  },
  "heading": {
    "$type": "color",
    "$value": "#eef0f6"
  },
  "body-muted": {
    "$type": "color",
    "$value": "#b9becf"
  },
  "on-media": {
    "$type": "color",
    "$value": "#ffffff"
  },
  "action-inverse": {
    "$type": "color",
    "$value": "#ffffff"
  },
  "action-inverse-fg": {
    "$type": "color",
    "$value": "#2f2f33"
  },
  "glass-fill": {
    "$type": "color",
    "$value": "rgba(255, 255, 255, 0.08)"
  },
  "glass-border": {
    "$type": "color",
    "$value": "rgba(255, 255, 255, 0.16)"
  },
  "hairline": {
    "$type": "color",
    "$value": "rgba(255, 255, 255, 0.14)"
  },
  "hairline-strong": {
    "$type": "color",
    "$value": "rgba(255, 255, 255, 0.28)"
  },
  "accent": {
    "$type": "color",
    "$value": "#e0a48d"
  },
  "scrim": {
    "$type": "color",
    "$value": "rgba(4, 5, 12, 0.46)"
  },
  "scrim-strong": {
    "$type": "color",
    "$value": "rgba(4, 5, 12, 0.68)"
  },
  "scrim-soft": {
    "$type": "color",
    "$value": "rgba(4, 5, 12, 0.12)"
  },
  "duration-fast": {
    "$type": "duration",
    "$value": "150ms"
  },
  "ease-entrance": {
    "$type": "cubicBezier",
    "$value": [0.2, 0, 0, 1]
  },
  "gutter": {
    "$type": "dimension",
    "$value": "clamp(1rem, 2.2vw, 2rem)",
    "note": "Web: viewport-clamped edge margin. Native (F-ADR-5): fixed 16dp; the Dart formatter emits that, no viewport scaling."
  },
  "bot-sage": {
    "$type": "color",
    "$value": "#7f9d8b"
  },
  "bot-sage-deep": {
    "$type": "color",
    "$value": "#22564d"
  },
  "bot-clay": {
    "$type": "color",
    "$value": "#a86650"
  },
  "bot-peach": {
    "$type": "color",
    "$value": "#dca58e"
  },
  "bot-lavender": {
    "$type": "color",
    "$value": "#afa7be"
  },
  "bot-butter": {
    "$type": "color",
    "$value": "#e9dfbd"
  },
  "bot-leaf": {
    "$type": "color",
    "$value": "#c3d6a9"
  },
  "bot-line": {
    "$type": "color",
    "$value": "rgba(127, 157, 139, 0.22)"
  }
}
