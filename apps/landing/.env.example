# Landing page environment. Copy to .env.local for local development.
# Postgres connection used by app/api/waitlist/*. Apply db/waitlist.sql once.
WAITLIST_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Bearer token for GET /api/waitlist/export. Generate: openssl rand -hex 32
WAITLIST_EXPORT_TOKEN=
