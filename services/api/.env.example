# Between API - environment example
# Copy to .env for local development. Never commit .env.
# Every variable here is validated at startup by src/config/config.ts.

NODE_ENV=development
PORT=3000

# Runtime role. Has no UPDATE/DELETE on append-only tables.
DATABASE_URL=postgresql://solace_app:solace_app@localhost:5432/solace?schema=public
# Owner role, used only for migrations and seeding. Falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=postgresql://solace:solace@localhost:5432/solace?schema=public

REDIS_URL=redis://localhost:6379

# Secrets: generate with `openssl rand -hex 32`. Never commit real values.
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Reference to the wrapped field-encryption data key. Not the key itself.
# Development: a file path or secret name resolved by the local key provider.
FIELD_ENCRYPTION_KEY_REF=dev://between-field-key

# AI providers. Required in staging and production only.
AI_GROQ_API_KEY=
AI_CEREBRAS_API_KEY=
AI_OPENROUTER_API_KEY=
AI_CRISIS_TIMEOUT_MS=1800

# Push, email and SMS. Required in staging and production only.
FCM_SERVICE_ACCOUNT_REF=
SENDGRID_API_KEY=
SMS_PROVIDER_KEY=

SENTRY_DSN=
LOG_LEVEL=debug
CORS_ORIGINS=

# Safety windows. See Open Decisions OD-1, OD-2, OD-6.
INVITE_TTL_HOURS=48
FRESHNESS_WINDOW_HOURS=2
PAUSE_CAP_DAYS=14

# Development only. Ignored when NODE_ENV=production.
TIMER_SCALE=1

# Last verification date for the crisis resources shown to clients.
RESOURCES_VERIFIED_AT=2026-10-24T00:00:00.000Z
